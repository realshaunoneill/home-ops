# Homelable secrets.
# Set these in the stack's Environment variables in Portainer (recommended), or
# copy to a local .env file that is not committed. Every one of them is guarded
# with `${VAR:?...}` in the compose file, so a missing value fails the deploy
# rather than starting the LAN-exposed backend with no auth.

# Session / token signing key. Needs >= 32 bytes.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Web UI login. Username defaults to `admin` if left unset.
AUTH_USERNAME=admin

# bcrypt hash of the web UI password.
# Generate with:
#   docker run --rm --entrypoint python ghcr.io/pouzor/homelable-backend:3.3.5 \
#     -c 'import bcrypt; print(bcrypt.hashpw(b"yourpassword", bcrypt.gensalt()).decode())'
#
# In a plain .env file the hash needs no escaping (as with wireguard's
# PASSWORD_HASH). In the PORTAINER env panel it does: that panel interpolates
# `$`, so paste the hash with every `$` doubled — $$2b$$12$$... — or the stored
# value arrives mangled and the login silently never matches.
AUTH_PASSWORD_HASH=$2b$12$replace-with-your-own-bcrypt-hash

# Authenticates AI clients (Claude Code, Claude Desktop) -> MCP server.
# Generate with: echo "mcp_sk_$(openssl rand -hex 24)"
MCP_API_KEY=

# Authenticates MCP server -> backend. Internal only, never sent to clients.
# Both the backend and mcp services read it, so one value covers both.
# Generate with: echo "svc_$(openssl rand -hex 24)"
MCP_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Optional importers — all off unless set. Each can also be driven one-off from
# the UI dialogs, which passes credentials in the request and keeps them out of
# the stack env entirely; the variables below are only needed for scheduled
# auto-sync. Homelable holds these in memory only and never returns them from
# any API endpoint. Add the ones you want to the backend `environment:` block
# in docker-compose.yml as ${VAR} references.
# ---------------------------------------------------------------------------

# Proxmox VE (192.168.0.200). Create the token under Datacenter -> Permissions
# -> API Tokens with the read-only PVEAuditor role at path "/".
# PROXMOX_HOST=192.168.0.200
# PROXMOX_PORT=8006
# PROXMOX_TOKEN_ID=root@pam!homelable
# PROXMOX_TOKEN_SECRET=
# PROXMOX_VERIFY_TLS=false        # false only because of the self-signed cert

# Zigbee2MQTT / Z-Wave JS UI, via the MQTT broker on the Home Assistant host.
# ZIGBEE_MQTT_HOST=192.168.0.245
# ZIGBEE_MQTT_PORT=1883
# ZIGBEE_MQTT_USERNAME=
# ZIGBEE_MQTT_PASSWORD=
# ZIGBEE_BASE_TOPIC=zigbee2mqtt
# ZWAVE_MQTT_HOST=192.168.0.245
# ZWAVE_MQTT_PORT=1883
# ZWAVE_PREFIX=zwave

# Read-only public canvas at /view?key=<value>. Off unless set.
# Generate with: openssl rand -base64 32
# LIVEVIEW_KEY=
