# Obsidian web session credentials (set in Portainer stack environment)
OBSIDIAN_WEB_USER=obsidian
OBSIDIAN_WEB_PASSWORD=change-this

# Git source for your vault
VAULT_GIT_REPO=https://github.com/realshaunoneill/Vault.git

# Optional: set a specific branch to mirror; leave blank to track repo default branch.
VAULT_GIT_BRANCH=

# Poll interval in seconds for auto-pull
VAULT_GIT_SYNC_INTERVAL=300
