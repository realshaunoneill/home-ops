# Gatus Pushover alerting variables
# Set these in Portainer stack Environment variables (recommended), or copy to a
# local .env file that is not committed.

# Pushover application token from pushover.net/apps
GATUS_PUSHOVER_APPLICATION_TOKEN=

# Pushover user or group key
GATUS_PUSHOVER_USER_KEY=

# Optional: target a specific Pushover device name
GATUS_PUSHOVER_DEVICE=
